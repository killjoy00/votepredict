    "eval:lifecycle:p4": "tsx scripts/evaluate-lifecycle-p4-baselines.ts",
    "eval:lifecycle:p5": "tsx scripts/evaluate-lifecycle-p5-evidence.ts",
    "eval:lifecycle:p6": "tsx scripts/evaluate-lifecycle-p6-end-to-end.ts",
    "build:lifecycle:p7-lineage": "tsx scripts/build-lifecycle-p7-lineage.ts",
