{
  "name": "votepredict",
  "version": "2.0.0-alpha.1",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "db:migrate": "tsx scripts/migrate.ts",
    "data:members:ingest": "tsx scripts/ingest-lrl-memberships.ts",
    "data:members:reconcile": "tsx scripts/reconcile-member-votes.ts",
    "data:history:audit": "tsx scripts/audit-historical-data.ts",
    "data:house:inspect": "tsx scripts/inspect-house-votes.ts",
    "data:house:ingest": "tsx scripts/ingest-house-history.ts",
    "data:revisor:enrich": "tsx scripts/enrich-revisor-bills.ts",
    "data:revisor:versions": "tsx scripts/enrich-revisor-bills.ts --include-versions --skip-existing",
    "data:senate:inspect": "tsx scripts/inspect-senate-journals.ts",
    "data:senate:ingest": "tsx scripts/ingest-senate-history.ts",
    "data:cfb:snapshot": "node scripts/build-cfb-snapshot.mjs",
    "data:cfb:evidence": "tsx scripts/ingest-cfb-evidence.ts",
    "data:evidence:bills": "tsx scripts/seed-evidence-bills.ts",
    "data:evidence:curated": "tsx scripts/ingest-evidence-manifest.ts",
    "data:evidence:legislators": "tsx scripts/ingest-evidence-manifest.ts --manifest data/evidence/legislator-context-v1.json",
    "features:bills:backfill": "tsx scripts/backfill-bill-features.ts",
    "features:analogues:inspect": "tsx scripts/inspect-bill-analogues.ts",
    "eval:baselines": "tsx scripts/evaluate-baselines.ts",
    "eval:member-model": "tsx scripts/evaluate-member-model.ts",
    "eval:analogue-lift": "tsx scripts/evaluate-analogue-lift.ts",
    "eval:gambling-model": "tsx scripts/evaluate-gambling-model.ts",
    "forecasts:scheduled": "tsx scripts/run-scheduled-forecasts.ts",
    "eval:coalition-chamber": "tsx scripts/evaluate-coalition-chamber.ts",
    "eval:gambling:diagnose": "tsx scripts/diagnose-gambling-model.ts"
  },
  "dependencies": {
    "@neondatabase/auth": "0.5.0-beta",
    "@vercel/functions": "3.9.5",
    "ai": "7.0.93",
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "pdf-parse": "2.4.5",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
