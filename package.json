    "next": "16.3.5",
    "pdf-parse": "2.4.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.3.0",
