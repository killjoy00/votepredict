    "eval:full-universe-stage": "tsx scripts/evaluate-full-universe-stage-baseline.ts",
    "eval:gambling-model": "tsx scripts/evaluate-gambling-model.ts",
    "eval:deep-vs-quick": "tsx scripts/evaluate-deep-vs-quick.ts",
