# Application database. Use the pooled Neon URL for normal app traffic.
DATABASE_URL=postgresql://user:password@host-pooler.example/votepredict?sslmode=require

# Direct Neon URL used only by schema migrations and administrative jobs.
DATABASE_URL_UNPOOLED=postgresql://user:password@host.example/votepredict?sslmode=require

# Managed Neon Auth endpoint. This value is not a secret.
NEON_AUTH_BASE_URL=https://your-neon-auth-endpoint.example/auth

# 32+ random characters used to sign cached auth session data.
NEON_AUTH_COOKIE_SECRET=replace-with-a-random-secret-at-least-32-characters

# Deep research uses Vercel AI Gateway. Vercel deployments can authenticate automatically;
# set an AI Gateway key for local/non-Vercel execution.
AI_GATEWAY_API_KEY=replace-with-ai-gateway-key

# Optional model override. The code default is versioned in the research provider.
VOTEPREDICT_DEEP_MODEL=openai/gpt-5.5
