# Required: OpenAI API key for AI vote predictions
# Create one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Optional: override the default OpenAI model
OPENAI_MODEL=gpt-5.4-mini

# Optional: OpenStates API key for higher rate limits on legislator/bill data
# Get one for free at: https://openstates.org/accounts/profile/
OPEN_STATES_API_KEY=your-openstates-key-here

# Optional: OpenStates session slug (defaults to the current regular session)
MN_OPENSTATES_SESSION=2025-2026

# Optional: override the official Revisor session code (defaults to the 94th Legislature)
MN_LEGISLATURE_SESSION=0942025

# Optional: canonical production URL accepted for prediction POST requests
PUBLIC_SITE_URL=https://your-deployment.example
